# ============================================================================
# SkinWise AI — Production & Development Environment Configuration
# ============================================================================

# Environment Detection (development, test, production)
# In production, high-entropy SECRET_KEY and WORKER_SECRET are strictly required (Fail-closed).
ENVIRONMENT=development

# Application Info
PROJECT_NAME="SkinWise AI Engine"
API_V1_STR="/api"
PORT=8000
HOST="127.0.0.1"

# ----------------------------------------------------------------------------
# Security, Tokens & Worker Secrets (MANDATORY IN PRODUCTION)
# ----------------------------------------------------------------------------
# In non-development environments, SECRET_KEY must be a cryptographically random,
# at least 32-character string. Never commit production secrets to Git.
SECRET_KEY="skinwise-dev-clinical-insecure-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days
GUEST_TOKEN_EXPIRE_MINUTES=1440    # 24 hours

# Independent worker authorization secret for automated retention cleanup (/api/auth/retention/worker-cleanup)
# In production, WORKER_SECRET must be at least 32 characters and distinct from SECRET_KEY.
WORKER_SECRET="skinwise-local-worker-secret-internal-use-only"

# Reverse Proxy Trust Configuration
BEHIND_TRUSTED_PROXY=false
TRUSTED_PROXIES="127.0.0.1,::1"

# ----------------------------------------------------------------------------
# Database & Persistence (P0 - MUST USE MANAGED POSTGRESQL IN PRODUCTION)
# ----------------------------------------------------------------------------
# SQLite (development default):
DATABASE_URL="sqlite:///./skinwise.db"

# Managed PostgreSQL (Production Recommendation):
# DATABASE_URL="postgresql://user:password@db-host.provider.com:5432/skinwise_db"

# Safety guard: prevent ephemeral /tmp SQLite database in production serverless environments.
# Set true ONLY for temporary, disposable preview environments.
ALLOW_EPHEMERAL_DATABASE_IN_PRODUCTION=false

# ----------------------------------------------------------------------------
# Private File Storage (Uploads & PDF Clinical Reports)
# ----------------------------------------------------------------------------
STORAGE_DIR="storage"
UPLOAD_DIR="storage/private_uploads"
REPORTS_DIR="storage/reports"

# ----------------------------------------------------------------------------
# AI Vision Inference Engine (Google Gemini & Hugging Face)
# ----------------------------------------------------------------------------
# Primary provider: "gemini" (default) or "huggingface"
PRIMARY_AI_PROVIDER="gemini"

# Google Gemini Vision Configuration
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# Hugging Face Dermatology Model Configuration (DINOv2)
# Fine-tuned model: Jayanth2002/dinov2-base-finetuned-SkinDisease
HF_TOKEN=""
HF_MODEL_ID="Jayanth2002/dinov2-base-finetuned-SkinDisease"

# Enable Hugging Face DINOv2 adapter as automatic fallback when Gemini is offline
ENABLE_HUGGINGFACE_FALLBACK=false

# ----------------------------------------------------------------------------
# Public Health APIs (openFDA CAERS & Open-Meteo Solar UV)
# ----------------------------------------------------------------------------
OPENFDA_API_KEY=""
OPENFDA_COSMETICS_URL="https://api.fda.gov/cosmetic/event.json"
OPEN_METEO_UV_URL="https://api.open-meteo.com/v1/forecast"

# ----------------------------------------------------------------------------
# Seeding Demonstration Account (Development Only)
# ----------------------------------------------------------------------------
# When true in non-production, seeds Sarah Jenkins (sarah.jenkins@example.com / SkinWise2026!)
SEED_DEMO_DATA=false

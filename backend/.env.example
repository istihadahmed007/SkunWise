# SkinWise AI - Backend Environment Configuration
PROJECT_NAME="SkinWise AI Engine"
API_V1_STR="/api"
PORT=8000
HOST="127.0.0.1"

# Security & Tokens
SECRET_KEY="replace_with_a_secure_random_64_char_key_for_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For SQLite (default development):
DATABASE_URL="sqlite:///./skinwise.db"
# For PostgreSQL (production):
# DATABASE_URL="postgresql://user:password@localhost:5432/skinwise"

# Optical Quality Viability Thresholds
MIN_SHARPNESS_LAPLACIAN=50.0
MIN_AMBIENT_LUX=35.0
MAX_SPECULAR_GLARE_RATIO=0.18

# Model & Storage
STORAGE_DIR="storage/derm_images"
MODEL_PATH="models/densenet121_isic.pt"
ZERO_CLOUD_DEFAULT=false
DATA_RETENTION_DAYS_DEFAULT=90

